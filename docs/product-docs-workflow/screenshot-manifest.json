{
  "$schema": "./screenshot-manifest.schema.json",
  "version": 1,
  "defaults": {
    "viewport": {
      "width": 1440,
      "height": 960
    },
    "locale": "en",
    "theme": "light",
    "outputDirectory": "docs/product/assets/screenshots"
  },
  "screenshots": [
    {
      "id": "settings",
      "title": "Settings",
      "fixture": "docs-basic",
      "output": "settings.png",
      "steps": [
        { "action": "click", "selector": "text:Settings" },
        { "action": "waitForDisplayed", "selector": "testid:settings-dialog" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "view-logs",
      "title": "View Logs",
      "fixture": "docs-basic",
      "output": "view-logs.png",
      "steps": [
        { "action": "click", "selector": "text:View Logs" },
        { "action": "waitForDisplayed", "selector": "text:Espanso Logs" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "search",
      "title": "Search",
      "fixture": "docs-basic",
      "output": "search.png",
      "steps": [
        { "action": "click", "selector": "text:Search" },
        { "action": "setValue", "selector": "placeholder:Search trigger, description or content...", "value": "meeting" },
        { "action": "waitForDisplayed", "selector": "testid:search-dialog" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "conflicts",
      "title": "Conflicts",
      "fixture": "docs-conflicts",
      "output": "conflicts.png",
      "steps": [
        { "action": "selectFile", "target": "base.yml" },
        { "action": "click", "selector": "textIncludes:Conflicts" },
        { "action": "waitForDisplayed", "selector": "testid:trigger-conflicts-dialog" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "visual-editor",
      "title": "Visual Editor",
      "fixture": "docs-basic",
      "output": "visual-editor.png",
      "steps": [
        { "action": "selectFile", "target": "base.yml" },
        { "action": "click", "selector": "text:Visual Editor" },
        { "action": "waitForDisplayed", "selector": "testid:visual-yaml-editor-dialog" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "batch-delete",
      "title": "Batch Delete",
      "fixture": "docs-basic",
      "output": "batch-delete.png",
      "steps": [
        { "action": "selectFile", "target": "base.yml" },
        { "action": "click", "selector": "text:Batch Delete" },
        { "action": "waitForDisplayed", "selector": "text:Delete Selected (0)" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "import-alfred",
      "title": "Import Alfred",
      "fixture": "docs-basic",
      "output": "import-alfred.png",
      "steps": [
        { "action": "selectFile", "target": "base.yml" },
        { "action": "click", "selector": "testid:import-alfred-btn" },
        { "action": "waitForDisplayed", "selector": "text:Import Alfred Snippets" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "add-snippet-text",
      "title": "Add Snippet Text",
      "fixture": "docs-basic",
      "output": "add-snippet-text.png",
      "steps": [
        { "action": "selectFile", "target": "base.yml" },
        { "action": "click", "selector": "text:Add Snippet" },
        { "action": "waitForDisplayed", "selector": "testid:snippet-edit-dialog" },
        { "action": "waitForDisplayed", "selector": "#replace" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "add-snippet-file",
      "title": "Add Snippet File",
      "fixture": "docs-basic",
      "output": "add-snippet-file.png",
      "steps": [
        { "action": "selectFile", "target": "base.yml" },
        { "action": "click", "selector": "text:Add Snippet" },
        { "action": "click", "selector": "testid:snippet-kind-file" },
        { "action": "waitForDisplayed", "selector": "#include-file" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "add-snippet-image",
      "title": "Add Snippet Image",
      "fixture": "docs-basic",
      "output": "add-snippet-image.png",
      "steps": [
        { "action": "selectFile", "target": "base.yml" },
        { "action": "click", "selector": "text:Add Snippet" },
        { "action": "click", "selector": "testid:snippet-kind-image" },
        { "action": "waitForDisplayed", "selector": "#image-path" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "add-snippet-form",
      "title": "Add Snippet Form",
      "fixture": "docs-basic",
      "output": "add-snippet-form.png",
      "steps": [
        { "action": "selectFile", "target": "base.yml" },
        { "action": "click", "selector": "text:Add Snippet" },
        { "action": "click", "selector": "testid:snippet-kind-form" },
        { "action": "waitForDisplayed", "selector": "#form" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "add-snippet-multiple-triggers",
      "title": "Add Snippet Multiple Triggers",
      "fixture": "docs-basic",
      "output": "add-snippet-multiple-triggers.png",
      "steps": [
        { "action": "selectFile", "target": "base.yml" },
        { "action": "click", "selector": "text:Add Snippet" },
        { "action": "setValue", "selector": "testid:trigger-input-0", "value": ":hello" },
        { "action": "click", "selector": "testid:add-trigger-alias-btn" },
        { "action": "setValue", "selector": "testid:trigger-input-1", "value": ":hi" },
        { "action": "waitForDisplayed", "selector": "testid:trigger-input-1" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "create-subdirectory",
      "title": "Create Subdirectory",
      "fixture": "docs-basic",
      "output": "create-subdirectory.png",
      "steps": [
        { "action": "click", "selector": "title:Create Subdirectory" },
        { "action": "waitForDisplayed", "selector": "testid:create-folder-dialog" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "create-new-yaml-file",
      "title": "Create New YAML File",
      "fixture": "docs-basic",
      "output": "create-new-yaml-file.png",
      "steps": [
        { "action": "click", "selector": "title:Create New YAML File" },
        { "action": "waitForDisplayed", "selector": "testid:create-file-dialog" }
      ],
      "capture": { "type": "window" }
    }
  ]
}
