{
  "$schema": "./screenshot-manifest.schema.json",
  "version": 1,
  "defaults": {
    "viewport": {
      "width": 1440,
      "height": 960
    },
    "locales": ["en", "zh-CN"],
    "theme": "light",
    "outputDirectory": "docs/product/assets/screenshots"
  },
  "screenshots": [
    {
      "id": "settings",
      "title": "Settings",
      "fixture": "docs-basic",
      "output": "settings.png",
      "steps": [
        { "action": "click", "selector": "testid:open-settings-btn" },
        { "action": "waitForDisplayed", "selector": "testid:settings-dialog" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "view-logs",
      "title": "View Logs",
      "fixture": "docs-basic",
      "output": "view-logs.png",
      "steps": [
        { "action": "click", "selector": "testid:open-logs-btn" },
        { "action": "waitForDisplayed", "selector": "testid:logs-dialog" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "search",
      "title": "Search",
      "fixture": "docs-basic",
      "output": "search.png",
      "steps": [
        { "action": "click", "selector": "testid:open-search-btn" },
        { "action": "setValue", "selector": "testid:search-input", "value": "meeting" },
        { "action": "waitForDisplayed", "selector": "testid:search-dialog" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "conflicts",
      "title": "Conflicts",
      "fixture": "docs-conflicts",
      "output": "conflicts.png",
      "steps": [
        { "action": "selectFile", "target": "base.yml" },
        { "action": "click", "selector": "testid:open-conflicts-btn" },
        { "action": "waitForDisplayed", "selector": "testid:trigger-conflicts-dialog" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "visual-editor-add-mode",
      "title": "Visual Editor Add Mode",
      "fixture": "docs-basic",
      "output": "visual-editor-add-mode.png",
      "steps": [
        { "action": "selectFile", "target": "base.yml" },
        { "action": "click", "selector": "testid:open-visual-editor-btn" },
        { "action": "waitForDisplayed", "selector": "testid:visual-yaml-editor-dialog" },
        { "action": "setValue", "selector": "testid:visual-editor-trigger-input-0", "value": ":docs-shot" },
        { "action": "setValue", "selector": "#ve-replace", "value": "Documentation screenshot replacement." },
        { "action": "setValue", "selector": "#ve-description", "value": "Visual editor add preview" },
        { "action": "click", "selector": "testid:visual-editor-save-btn" },
        { "action": "waitForDisplayed", "selector": "testid:visual-editor-yaml-highlighted-line" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "visual-editor-delete-mode",
      "title": "Visual Editor Delete Mode",
      "fixture": "docs-basic",
      "output": "visual-editor-delete-mode.png",
      "steps": [
        { "action": "selectFile", "target": "base.yml" },
        { "action": "click", "selector": "testid:open-visual-editor-btn" },
        { "action": "waitForDisplayed", "selector": "testid:visual-yaml-editor-dialog" },
        { "action": "click", "selector": "testid:visual-editor-mode-delete" },
        { "action": "click", "selector": "testid:visual-editor-delete-toggle-0-0" },
        { "action": "waitForDisplayed", "selector": "testid:visual-editor-yaml-highlighted-line" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "batch-delete",
      "title": "Batch Delete",
      "fixture": "docs-basic",
      "output": "batch-delete.png",
      "steps": [
        { "action": "selectFile", "target": "base.yml" },
        { "action": "click", "selector": "testid:open-batch-delete-btn" },
        { "action": "waitForDisplayed", "selector": "testid:batch-select-all" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "import-alfred",
      "title": "Import Alfred",
      "fixture": "docs-basic",
      "output": "import-alfred.png",
      "steps": [
        { "action": "selectFile", "target": "base.yml" },
        { "action": "click", "selector": "testid:import-alfred-btn" },
        { "action": "waitForDisplayed", "selector": "testid:import-alfred-dialog" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "add-snippet-text",
      "title": "Add Snippet Text",
      "fixture": "docs-basic",
