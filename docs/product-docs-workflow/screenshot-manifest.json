      "fixture": "docs-basic",
      "output": "add-snippet-html-mode.png",
      "steps": [
        { "action": "click", "selector": "testid:open-settings-btn" },
        { "action": "click", "selector": "testid:rich-text-snippets-switch" },
        { "action": "click", "selector": "testid:settings-done-btn" },
        { "action": "selectFile", "target": "base.yml" },
        { "action": "click", "selector": "testid:open-add-snippet-btn" },
        { "action": "click", "selector": "testid:text-format-html" },
        { "action": "waitForDisplayed", "selector": "testid:text-format-html" }
      ],
      "capture": { "type": "window" }
    },
    {
      "id": "create-subdirectory",
      "title": "Create Subdirectory",
      "fixture": "docs-basic",
      "output": "create-subdirectory.png",
      "steps": [
        { "action": "click", "selector": "testid:create-subdirectory-btn" },
        { "action": "waitForDisplayed", "selector": "testid:create-folder-dialog" }
      ],
      "capture": { "type": "window" }
