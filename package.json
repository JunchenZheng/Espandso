{
  "name": "expandso",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "generate:icons": "./scripts/generate_icons.sh",
    "setup:windows": "./scripts/setup-windows-cross-build.sh",
    "tauri": "tauri",
    "tauri:dev": "npm run generate:icons && npm run tauri -- dev",
    "tauri:build": "npm run generate:icons && npm run tauri -- build",
    "build:windows": "./scripts/build-windows-cross.sh",
    "build:windows:native": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "build:e2e": "npm run generate:icons && VITE_EXPANDSO_E2E=1 npm run tauri -- build --debug --features e2e --config e2e/tauri.e2e.conf.json",
    "test:e2e": "npm run build:e2e && wdio run e2e/wdio.conf.ts",
    "docs:screenshots": "node scripts/docs-screenshots.mjs",
    "docs:screenshots:tauri": "npm run build:e2e && wdio run e2e/wdio.screenshots.conf.ts",
    "test": "npm run test:unit:ts && npm run test:component",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "test:unit:ts": "vitest run --config vitest.unit.config.ts",
    "test:unit:rs": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:component:watch": "vitest --config vitest.component.config.ts",
    "type-check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "type-check:rs": "cargo check --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint .",
    "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "format:check": "prettier --check \"*.{js,json,ts}\" \"src/**/*.{ts,tsx,css}\"",
    "format:write": "prettier --write \"*.{js,json,ts}\" \"src/**/*.{ts,tsx,css}\"",
    "format:check:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "format:write:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "check:unit": "npm run test:unit:ts && npm run test:unit:rs",
    "check:component": "npm run test:component",
    "check:integration": "npm run test:integration",
    "check:all": "npm run check:unit && npm run test:component && npm run test:integration",
    "check:static": "npm run type-check && npm run type-check:rs && npm run lint && npm run lint:rs && npm run format:check && npm run format:check:rs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-scroll-area": "^1.2.15",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@types/jszip": "^3.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.25.0",
    "marked": "^18.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "9.27.1",
    "@wdio/globals": "9.27.1",
    "@wdio/local-runner": "9.27.1",
    "@wdio/mocha-framework": "9.27.1",
    "@wdio/native-utils": "2.5.0",
    "@wdio/spec-reporter": "9.27.1",
    "@wdio/tauri-plugin": "1.2.0",
    "@wdio/tauri-service": "1.2.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "postcss": "^8.5.20",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@wdio/native-utils": "2.5.0"
  }
}
