{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/Library/Application Support/espanso/match/**" },
        { "path": "$HOME/AppData/Roaming/espanso/match/**" },
        { "path": "$CONFIG/espanso/match/**" },
        { "path": "$DATA/espanso/match/**" }
      ]
    },
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:read-all",
    "fs:write-all",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/Library/Application Support/espanso/match" },
        { "path": "$HOME/Library/Application Support/espanso/match/**" },
        { "path": "$HOME/AppData/Roaming/espanso/match" },
        { "path": "$HOME/AppData/Roaming/espanso/match/**" },
        { "path": "$CONFIG/espanso/match" },
        { "path": "$CONFIG/espanso/match/**" },
        { "path": "$DATA/espanso/match" },
        { "path": "$DATA/espanso/match/**" }
      ]
    },
    "dialog:default",
    "store:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "espanso",
          "cmd": "espanso",
          "args": ["restart"]
        },
        {
          "name": "espanso",
          "cmd": "espanso",
          "args": ["path"]
        }
      ]
    }
  ]
}
